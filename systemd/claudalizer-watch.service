[Unit]
Description=AgentSignals Continuous Session Watcher
Documentation=https://github.com/example/agent-signals

[Service]
Type=simple
ExecStart=%h/.local/bin/agent-signals watch
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
