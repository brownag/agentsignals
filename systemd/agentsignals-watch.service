[Unit]
Description=agentsignals Continuous Session Watcher
Documentation=https://github.com/example/agentsignals

[Service]
Type=simple
ExecStart=%h/.local/bin/agentsignals watch
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
